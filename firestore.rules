rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Listings: anyone can read, authenticated can create/delete, everyone can increment viewCount
    match /listings/{listingId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if (request.auth != null) || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']));
    }
    
    // Users: anyone can read the basic user profile, but only the user can write.
    // Subcollections (e.g. likes) are restricted to the user themselves.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Chats: only participants can read/write
    match /chats/{chatId} {
      allow read, write: if request.auth != null && request.auth.uid in resource.data.participants;
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // Categories, Banners, Popups, Notices: anyone can read, only admin can write
    match /categories/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
         request.auth.token.email == 'grandcity@naver.com');
    }

    match /banners/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
         request.auth.token.email == 'grandcity@naver.com');
    }

    match /popups/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
         request.auth.token.email == 'grandcity@naver.com');
    }

    match /notices/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
         request.auth.token.email == 'grandcity@naver.com');
    }

    // Reports: any authenticated user can create, only admin can read/write
    match /reports/{document=**} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
         request.auth.token.email == 'grandcity@naver.com');
    }

    // Inquiries: User can create and read own, admin can read and update all
    match /inquiries/{inquiryId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && 
        (resource.data.userId == request.auth.uid || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         request.auth.token.email == 'grandcity@naver.com');
      allow update: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         request.auth.token.email == 'grandcity@naver.com');
    }

    // Diagnostic test collection (temporary)
    match /diagnostic_test/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Reviews: anyone can read, authenticated users can create
    match /reviews/{document=**} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.authorId || 
         request.auth.uid == resource.data.agentId || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
         request.auth.token.email == 'grandcity@naver.com');
      allow delete: if request.auth != null && 
        (request.auth.uid == resource.data.authorId || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
         request.auth.token.email == 'grandcity@naver.com');
    }

    // Default: deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}