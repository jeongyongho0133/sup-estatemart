rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isMasterEmail() {
      return isAuthenticated() && 
        (request.auth.token.email == 'grandcity@naver.com' || 
         request.auth.token.email == 'grand75761500@gmail.com' ||
         request.auth.token.email == 'yungho.jeong@gmail.com');
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             getUserData().role == role;
    }
    
    function isAdmin() {
      return isMasterEmail() || hasRole('admin') || hasRole('sub-admin');
    }

    // Listings: anyone can read, authenticated can create/delete, everyone can increment viewCount
    match /listings/{listingId} {
      allow read: if true;
      allow create, delete: if isAuthenticated();
      allow update: if isAuthenticated() || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']));
    }
    
    // Users: anyone can read the basic user profile, but only the user or admin can write.
    match /users/{userId} {
      allow read: if true;
      allow write: if isAdmin() || 
        (request.auth != null && (request.auth.token.email == 'grandcity@naver.com' || request.auth.token.email == 'grand75761500@gmail.com' || request.auth.token.email == 'yungho.jeong@gmail.com' || request.auth.uid == userId));
      
      match /{document=**} {
        allow read, write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      }
    }

    // Chats: only participants can read/write
    match /chats/{chatId} {
      allow read, write: if isAuthenticated() && request.auth.uid in resource.data.participants;
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // Admin-only write collections
    match /categories/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /banners/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /popups/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /notices/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{document=**} { allow read: if true; allow write: if isAdmin(); }
    
    // Reports & Inquiries
    match /reports/{document=**} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    match /inquiries/{inquiryId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
    }

    // Diagnostic test
    match /diagnostic_test/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Reviews
    match /reviews/{document=**} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && (request.auth.uid == resource.data.authorId || request.auth.uid == resource.data.agentId));
    }

    // Search Keywords
    match /search_keywords/{document=**} {
      allow create: if true;
      allow read: if isAdmin();
    }

    // Audit Logs
    match /audit_logs/{document=**} {
      allow read, write: if isAdmin();
    }

    // Listing Stats: read by everyone, create/update by everyone
    match /listing_stats/{statId} {
      allow read, write: if true;
    }

    // Default: deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}