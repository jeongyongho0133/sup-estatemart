rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Listing images: authenticated users can upload, anyone can read
    match /listings/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Profile pictures: owners can write, anyone can read
    match /profile_pictures/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Verification documents: owners can write, admin can read
    match /verification_docs/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
